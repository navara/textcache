{
   "action": {
      "default_icon": {
         "16": "icons/icon-16.png",
         "32": "icons/icon-32.png"
      },
      "default_popup": "popup/popup.html",
      "default_title": "TextCache: your saved texts"
   },
   "background": {
      "service_worker": "background.js",
      "type": "module"
   },
   "content_scripts": [ {
      "all_frames": true,
      "js": [ "content.js" ],
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "matches": [ "<all_urls>" ],
      "run_at": "document_idle"
   } ],
   "default_locale": "en",
   "description": "__MSG_ext_description__",
   "homepage_url": "https://github.com/navara/textcache",
   "icons": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "TextCache",
   "options_ui": {
      "open_in_tab": true,
      "page": "options/options.html"
   },
   "permissions": [ "storage", "unlimitedStorage", "alarms", "clipboardWrite", "activeTab" ],
   "version": "1.0"
}
